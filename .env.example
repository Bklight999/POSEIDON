# Copy to .env and supply your own values. Do not commit .env.

# Generation: full OpenAI-compatible chat/completions endpoint and model.
STEM_GW_URL=https://api.example.invalid/v1/chat/completions
STEM_GW_MODEL=your-model-name
STEM_GW_KEY=
STEM_GW_MODE=openai
# Optional separate model identifiers for each generation tier.
STEM_GW_MODEL_FLASH=
STEM_GW_MODEL_PRO=

# QC: full OpenAI-compatible chat/completions endpoint, model, and bearer key.
STEM_QC_URL=https://api.example.invalid/v1/chat/completions
STEM_QC_MODEL=your-qc-model-name
STEM_QC_KEY=

# Optional gateway-specific authentication; leave empty when unused.
STEM_GW_APP_ID=
STEM_GW_APP_KEY=
STEM_QC_KEY_ZHIPU=
STEM_QC_KEY_AZURE=

# Additional private terms to redact before outbound requests: a JSON array.
STEM_REDACT_TERMS='[]'

# GitHub personal access token for repository search.
GITHUB_TOKEN=

# Optional container registry configuration and authentication.
DOCKER_REGISTRY=registry.example.invalid
DOCKER_NAMESPACE=your-namespace
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Optional distributed workers. Replace placeholder paths before use.
# STEM_PROJECT_ROOT=/path/to/project
STEM_PYTHON_BIN=python3
STEM_SSH_PORT=22
STEM_SSH_PASSWORD=
